# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
.vite/

# Test output
coverage/
test-results/
playwright-report/
e2e/.tmp/

# Local data (SQLite, seeded on first run)
data/
*.sqlite*
*.db
*.db-shm
*.db-wal

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
# The contents, not the directory: git will not re-include a file whose parent directory is
# excluded, so `.vscode/` would make the two negations below dead letters. Those two are shared
# deliberately - format-on-save is one of the four places CONTROLS.md keeps Prettier applied.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# Screenshot walkthroughs (e2e/tools/screenshots.mjs)
screenshots/i18n/
